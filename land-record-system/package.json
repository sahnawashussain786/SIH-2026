{
  "name": "land-record-system",
  "version": "1.0.0",
  "private": true,
  "description": "Intelligent Land Record Digitization and Validation System (SIH-2026) — MERN + Python AI microservice",
  "scripts": {
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:all": "node scripts/dev.mjs",
    "dev:no-ai": "node scripts/dev.mjs --no-ai",
    "kill": "node scripts/dev.mjs --kill",
    "stop": "node scripts/dev.mjs --stop",
    "check": "node scripts/dev.mjs --check",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev:ai": "npm run dev --prefix ai-service",
    "build": "npm run build --prefix client",
    "start:server": "npm run start --prefix server",
    "seed": "npm run seed --prefix server",
    "smoke-test": "node server/scripts/smokeTest.js"
  }
}
