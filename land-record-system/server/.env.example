# Server environment
PORT=5000
NODE_ENV=development

# MongoDB (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/land_record_system

# Auth
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

# AI microservice
AI_SERVICE_URL=http://localhost:8001
AI_TIMEOUT_MS=60000
AI_KEY=dev-ai-key
AI_FALLBACK=true

# Upload limits
MAX_UPLOAD_MB=15
UPLOAD_DIR=uploads
