[TEMPLATE]
# Server environment
PORT=5000
NODE_ENV=development

# MongoDB (local or Atlas — Atlas is REQUIRED for Vercel deployment)
MONGO_URI=mongodb://127.0.0.1:27017/land_record_system

# Gemini direct extraction (primary engine — works on Vercel serverless)
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Set to false to make the Python AI service the primary engine again
GEMINI_DIRECT=true

# Auth
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# CORS — comma-separated allow-list. For production add your Vercel app URL:
# CLIENT_URL=http://localhost:5173,https://bhoomi-ai.vercel.app
CLIENT_URL=http://localhost:5173

# AI microservice (local dev only — optional on Vercel)
AI_SERVICE_URL=http://localhost:8001
AI_TIMEOUT_MS=90000
AI_KEY=dev-ai-key
AI_FALLBACK=true

# Upload limits (uploads are persisted in MongoDB via GridFS — no disk needed)
MAX_UPLOAD_MB=15
UPLOAD_DIR=uploads
