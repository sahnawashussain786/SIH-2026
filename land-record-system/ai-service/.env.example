# --- AI service environment ---
API_KEY=dev-ai-key
PORT=8001

# ---- Gemini (primary extraction engine) ----
# Get a free API key at https://aistudio.google.com/apikey
# With a key set, Gemini reads scans/PDFs directly (no Tesseract needed)
# and extraction quality improves dramatically on noisy/handwritten docs.
GEMINI_API_KEY=
# Model: # "gemini-flash-latest" always tracks Google's current Flash model (recommended).
# Pin a specific version if you prefer, e.g. gemini-2.5-flash or gemini-3.6-flash
GEMINI_MODEL=gemini-flash-latest
# Set to false to disable Gemini even when a key is present (regex-only mode)
GEMINI_ENABLED=true

# ---- Tesseract OCR (optional cross-check; Gemini replaces the need for it) ----
# Windows example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# OCR languages to install/use, e.g. eng+hin+ben
OCR_LANGS=eng+hin+ben
